# Google Maps API Configuration
# Get your API key from: https://console.cloud.google.com/google/maps-apis
REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Search API Configuration
# For local development, use: http://localhost:8080
# For production (Cloud Run), use: https://search-service-315949479081.europe-west4.run.app
REACT_APP_SEARCH_API_URL=http://localhost:8080

# Firebase Configuration
# Get these values from Firebase Console > Project Settings > Your apps
# Only REACT_APP_FIREBASE_API_KEY is sensitive — rotate it if exposed
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id
REACT_APP_FIREBASE_MEASUREMENT_ID=your_measurement_id
